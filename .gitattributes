# Keep repository text files stable across Windows, macOS, and Linux.
* text=auto

# Repository metadata and placeholder files use LF as well.
.gitattributes text eol=lf
.gitignore     text eol=lf
*.gitkeep      text eol=lf

# Source code, configuration, and documentation use LF.
*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.hpp     text eol=lf
*.ino     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf

# Native Windows scripts use CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# KiCad design files are text and benefit from normal diffs.
*.kicad_pcb text eol=lf
*.kicad_sch text eol=lf

# Common binary artifacts must not be line-ending converted.
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.zip     binary

# Preserve original CAD exchange bytes and header encoding
hardware/mechanical/*.STEP -text
